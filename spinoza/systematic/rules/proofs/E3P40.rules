# La haine imaginée d'autrui est d'abord exposée comme une tristesse source,
# afin que E3P27 puisse imiter l'affect sans règle spéciale pour la haine.
RULE E3P40D_haine_imaginee_devient_tristesse_source
WHEN
    ($ame imagine ($autrui hait $ame))
    ($source est_temoignage_tristesse_de ($autrui hait $ame))
THEN
    ADD ($ame imagine ($source est_tristesse_de $autrui))
    ADD ($source est_haine_imaginee_de $autrui)
END

# L'absence de cause donnée est une croyance positive. Elle rattache la
# tristesse imitée à l'idée d'autrui, puis E3P13S nomme la haine réciproque.
RULE E3P40D_absence_cause_rattache_tristesse_a_autrui
WHEN
    ($ame croit_n_avoir_donne_aucune_cause_de_haine_a $autrui)
    ($tristesse est_tristesse_de $ame)
    ($tristesse correspond_a_affect_imagine $source)
    ($source est_haine_imaginee_de $autrui)
    ($idee_autrui est_idee_de $autrui)
THEN
    ADD ($idee_autrui accompagne $tristesse)
END

# Scolie : si l'agent croit au contraire avoir donné une juste cause, la
# tristesse est rapportée à une cause intérieure et devient honte via E3P30S.
RULE E3P40S_cause_juste_prepare_honte
WHEN
    ($ame imagine ($autrui hait $ame))
    ($ame croit_avoir_donne_juste_cause_de_haine_a $autrui)
    ($honte est_temoignage_honte_de ($ame envers $autrui))
THEN
    ADD ($honte est_tristesse_de $ame)
    ADD ($honte a_pour_cause_interieure $ame)
    ADD ($ame se_croit_blame VRAI)
END

RULE E3P40C1_amour_et_haine_reciproque_fluctuation
WHEN
    ($ame aime $autrui)
    ($ame hait $autrui)
THEN
    ADD ($ame aime_et_hait_en_meme_temps $autrui)
    ADD ($ame est_en fluctuation_de_l_ame)
END

# Corollaire II : E3P39 fournit l'effort nuisible général ; le mal reçu
# sélectionne ensuite l'action identique à rendre.
RULE E3P40C2_mal_subi_selectionne_retour
WHEN
    ($ame imagine ($autrui a_fait_par_haine $mal))
    ($mal est_mal_subi_par $ame)
    ($action_retour reproduit $mal)
    ($action_retour est_action_nuisible_envers $autrui)
    ($ame s_efforce_de_faire_du_mal_a $autrui)
THEN
    ADD ($ame s_efforce_de_rendre $mal)
    ADD ($ame s_efforce_de_faire $action_retour)
END

RULE E3P40S_effort_rendre_mal_est_vengeance
WHEN
    ($ame s_efforce_de_rendre $mal)
    ($vengeance est_temoignage_vengeance_de ($ame rend $mal))
THEN
    ADD ($vengeance est_vengeance_de $ame)
END
