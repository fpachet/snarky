# Le conatus de l'âme se spécifie comme effort d'imaginer lorsque l'objet est
# imaginé et que son idée augmente ou seconde la puissance de l'âme.
RULE E3P12D_effort_imaginer_augmentation
WHEN
    ($ame imagine $objet)
    ($idee est_idee_de $objet)
    ($idee augmente_puissance_agir_de $ame)
    ($ame s_efforce_de_perseverer_dans son_etre)
THEN
    ADD ($ame s_efforce_d_imaginer $objet)
END

RULE E3P12D_effort_imaginer_soutien
WHEN
    ($ame imagine $objet)
    ($idee est_idee_de $objet)
    ($idee seconde_puissance_agir_de $ame)
    ($ame s_efforce_de_perseverer_dans son_etre)
THEN
    ADD ($ame s_efforce_d_imaginer $objet)
END
