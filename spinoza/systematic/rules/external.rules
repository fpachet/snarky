# Résultats des parties I et II utilisés dans les démonstrations initiales.
# Ils sont formulés comme ponts d'inférence explicites et non comme conclusions
# de la partie III.

# E1P36 : toute chose donnée produit nécessairement un effet. Le témoin de cet
# effet est fourni explicitement car le moteur ne crée pas encore d'objet.
RULE E1P36_donnee_effet_necessaire
WHEN
    ($idee est_donnee VRAI)
    ($effet est_temoignage_effet_de $idee)
THEN
    ADD ($effet suit_necessairement_de $idee)
END

# Reconstruction de E2P11C pour une idée adéquate dans une âme.
RULE E2P11C_idee_adequate_cause_adequate
WHEN
    ($effet suit_necessairement_de $idee)
    ($idee est_adequate_dans $ame)
THEN
    ADD ($ame est_cause_adequate_de $effet)
END

# Reconstruction de E2P11C : une idée inadéquate ne fait de l'âme qu'une cause
# partielle de l'effet qui en suit.
RULE E2P11C_idee_inadequate_cause_partielle
WHEN
    ($effet suit_necessairement_de $idee)
    ($idee est_inadequate_dans $ame)
THEN
    ADD ($ame est_cause_partielle_de $effet)
END

# E2P6/E2P7 : un mode d'un attribut ne détermine pas un mode d'un attribut
# distinct selon une détermination propre à ce second attribut.
RULE E2P06_independance_causale_des_attributs
WHEN
    ($source mode_de $attribut_source)
    ($cible mode_de $attribut_cible)
    ($determination porte_sur_attribut $attribut_cible)
    ($attribut_source est_distinct_de $attribut_cible)
THEN
    ADD ($source $determination $cible) ' FAUX
END

# E1P25C : les choses singulières sont des modes déterminés des attributs de
# Dieu. Le choix de l'attribut reste explicite dans l'instanciation ground.
RULE E1P25C_chose_singuliere_mode_determine
WHEN
    ($chose est_chose_singuliere VRAI)
    ($attribut est_attribut_de dieu)
THEN
    ADD ($chose est_mode_determine_de $attribut)
END

# E1P34 : le mode déterminé exprime la puissance de Dieu sous son attribut.
RULE E1P34_mode_exprime_puissance
WHEN
    ($chose est_mode_determine_de $attribut)
    ($attribut est_attribut_de dieu)
THEN
    ADD ($chose exprime_puissance_de dieu)
END

# E1P29 : l'effet nécessaire d'une essence actuelle reste dans les limites de
# la nature de la chose dont elle est l'essence.
RULE E1P29_effet_dans_limites_nature
WHEN
    ($effet suit_necessairement_de $essence)
    ($essence est_essence_actuelle_de $chose)
THEN
    ADD ($effet est_dans_limites_nature_de $chose)
END

# E2P23 : l'âme ne se connaît elle-même qu'en tant qu'elle perçoit les idées
# des affections du corps.
RULE E2P23_idee_affection_conscience_de_soi
WHEN
    ($affection affecte $corps)
    ($idee_affection est_idee_de $affection)
    ($ame est_idee_de $corps)
THEN
    ADD ($ame a_conscience_de $ame)
END

# E2P9C : si une chose destructrice ne peut être donnée dans le corps, son idée
# ne peut être donnée en Dieu en tant qu'il a l'idée de ce corps.
RULE E2P09C_exclusion_objet_transmise_a_son_idee
WHEN
    ($objet peut_etre_donne_dans $corps) ' FAUX
    ($idee est_idee_de $objet)
    (dieu a_idee_de $corps)
THEN
    ADD ($idee est_donnee_en_dieu_en_tant_qu_idee_de $corps) ' FAUX
END

# E2P11/E2P13 : l'âme est l'idée du corps ; l'exclusion précédente se transmet
# donc au domaine des idées données dans cette âme.
RULE E2P11_E2P13_idee_de_corps_dans_ame
WHEN
    ($ame est_idee_de $corps)
    ($idee est_donnee_en_dieu_en_tant_qu_idee_de $corps) ' FAUX
THEN
    ADD ($idee est_donnee_dans $ame) ' FAUX
END

# E2P7/E2P14 : l'ordre des modifications corporelles et celui de leurs idées
# est le même. Les quatre verbes de E3P11 restent distingués.
RULE E2P07_augmentation_corps_augmentation_ame
WHEN
    ($chose augmente_puissance_agir_de $corps)
    ($idee est_idee_de $chose)
    ($ame est_idee_de $corps)
THEN
    ADD ($idee augmente_puissance_agir_de $ame)
END


RULE E2P07_diminution_corps_diminution_ame
WHEN
    ($chose diminue_puissance_agir_de $corps)
    ($idee est_idee_de $chose)
    ($ame est_idee_de $corps)
THEN
    ADD ($idee diminue_puissance_agir_de $ame)
END


RULE E2P07_soutien_corps_soutien_ame
WHEN
    ($chose seconde_puissance_agir_de $corps)
    ($idee est_idee_de $chose)
    ($ame est_idee_de $corps)
THEN
    ADD ($idee seconde_puissance_agir_de $ame)
END


RULE E2P07_reduction_corps_reduction_ame
WHEN
    ($chose reduit_puissance_agir_de $corps)
    ($idee est_idee_de $chose)
    ($ame est_idee_de $corps)
THEN
    ADD ($idee reduit_puissance_agir_de $ame)
END
