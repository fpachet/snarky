RULE E3DA01_desir_essence_determinee_par_affection
WHEN
    ($essence est_essence_actuelle_de $homme)
    ($affection determine_essence_a_action ($essence vers $action))
    ($desir est_temoignage_desir_de ($homme envers $action))
THEN
    ADD ($desir est_desir_de $homme)
    ADD ($desir exprime_essence_de $homme)
    ADD ($desir est_determine_a $action)
    ADD ($desir nait_de $affection)
END
