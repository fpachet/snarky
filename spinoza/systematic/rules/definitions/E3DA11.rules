RULE E3DA11_derision_joie_mepris_dans_chose_haie
WHEN
    ($joie est_joie_de $ame)
    ($ame hait $objet)
    ($ame imagine ($objet contient $trait))
    ($trait est_meprisable_pour $ame)
    ($joie nait_de ($ame imagine ($objet contient $trait)))
THEN
    ADD ($joie est_derision_de ($ame envers $objet))
END
