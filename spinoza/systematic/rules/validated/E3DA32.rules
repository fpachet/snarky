RULE E3DA32_definition_souhait_frustre
WHEN
    ($desir est_desir_ou_appetit_de_posseder ($homme envers $chose))
    ($souvenir_chose est_souvenir_de $chose)
    ($souvenir_chose alimente $desir)
    ($souvenir_obstacle exclut_existence_de $chose)
    ($souvenir_obstacle reduit $desir)
THEN
    ADD ($desir est_souhait_frustre_de ($homme envers $chose))
END
