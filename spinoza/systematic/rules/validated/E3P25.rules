RULE E3P25_joie_chose_aimee_effort_affirmer
WHEN
    ($ame aime $cible)
    ($ame imagine ($contenu affecte_de_joie $cible))
    ($ame imagine ($affect_source a_pour_cause_exterieure $contenu))
    ($affect_observateur correspond_a_affect_imagine $affect_source)
    ($affect_observateur est_joie_de $ame)
THEN
    ADD ($ame s_efforce_d_affirmer ($contenu est_affirme_de $cible))
END

RULE E3P25_tristesse_chose_aimee_effort_nier
WHEN
    ($ame aime $cible)
    ($ame imagine ($contenu affecte_de_tristesse $cible))
    ($ame imagine ($affect_source a_pour_cause_exterieure $contenu))
    ($affect_observateur correspond_a_affect_imagine $affect_source)
    ($affect_observateur est_tristesse_de $ame)
THEN
    ADD ($ame s_efforce_de_nier ($contenu est_nie_de $cible))
END

RULE E3P25_joie_de_soi_effort_affirmer
WHEN
    ($ame imagine ($contenu affecte_de_joie $ame))
    ($ame imagine ($affect_source a_pour_cause_exterieure $contenu))
    ($affect_observateur correspond_a_affect_imagine $affect_source)
    ($affect_observateur est_joie_de $ame)
THEN
    ADD ($ame s_efforce_d_affirmer ($contenu est_affirme_de $ame))
END

RULE E3P25_tristesse_de_soi_effort_nier
WHEN
    ($ame imagine ($contenu affecte_de_tristesse $ame))
    ($ame imagine ($affect_source a_pour_cause_exterieure $contenu))
    ($affect_observateur correspond_a_affect_imagine $affect_source)
    ($affect_observateur est_tristesse_de $ame)
THEN
    ADD ($ame s_efforce_de_nier ($contenu est_nie_de $ame))
END
