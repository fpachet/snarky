RULE E3DA04_definition_etonnement
WHEN
    ($ame imagine $objet)
    ($image est_image_de $objet)
    ($image est_sans_connexion_avec_autres_images_pour $ame)
    ($ame demeure_attachee_a $image)
    ($etonnement est_temoignage_etonnement_de ($ame envers $objet))
THEN
    ADD ($etonnement est_etonnement_de $ame)
END
