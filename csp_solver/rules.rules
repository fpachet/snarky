GROUP apply_csp_choices
    # Chaque variable non affectee expose un point de choix declaratif.
    # Les instanciations de FROM deviennent les alternatives du fait decision.
    RULE choose_csp_value
    WHEN
        ($problem kind csp_problem)
        ($problem variable $variable)
        NOT EXISTS ($variable value $assigned)
    THEN
        CHOICE ($variable decision $chosen) WEIGHT $weight
        FROM
            ($variable candidate $chosen)
            ($variable choice_weight SEQ[$chosen $weight])
        END_CHOICE
    END

    # Une decision de branche réduit le domaine factuel à une seule valeur.
    # Les groupes génériques de propagation binaire font ensuite le reste.
    RULE restrict_chosen_domain
    WHEN
        ($variable decision $chosen)
        ($variable candidate $other)
        $other != $chosen
    THEN
        REMOVE ($variable candidate $other)
    END

    RULE reject_missing_choice_value
    WHEN
        ($variable decision $chosen)
        NOT EXISTS
            ($variable candidate $chosen)
        END_NOT_EXISTS
    THEN
        ADD (search state contradiction)
        ADD (search invalid_choice $variable)
    END
END_GROUP
