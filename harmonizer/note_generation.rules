# Les quadruplets sont engendrés avec leur accord et leur renversement.
# Le vocabulaire factuel pré-indexe les hauteurs de chaque accord par voix.
# NVALUE exprime la complétude : trois classes pour une triade, quatre pour V7.
# Les politiques de doublure sont des règles séparées et nommées.

GROUP generate_candidate_voicings
    RULE generate_legal_tonal_voicing
    WHEN
        ($position chord_variable $chord_variable)
        ($position inversion_variable $inversion_variable)
        ($position soprano_variable $soprano_variable)
        ($position alto_variable $alto_variable)
        ($position tenor_variable $tenor_variable)
        ($position bass_variable $bass_variable)
        ($chord_variable candidate $chord)
        ($inversion_variable candidate $inversion)
        ($chord allows_inversion $inversion)
        ($soprano_variable candidate $soprano)
        ($alto_variable candidate $alto)
        ($tenor_variable candidate $tenor)
        ($bass_variable candidate $bass)
        ($chord voice_pitch SEQ[soprano $soprano])
        ($chord voice_pitch SEQ[alto $alto])
        ($chord voice_pitch SEQ[tenor $tenor])
        ($chord inversion_bass_pitch SEQ[$inversion $bass])
        ($chord chord_cardinality $cardinality)
        ($soprano pitch_class $soprano_class)
        ($alto pitch_class $alto_class)
        ($tenor pitch_class $tenor_class)
        ($bass pitch_class $bass_class)
        $soprano > $alto
        $alto > $tenor
        $tenor > $bass
        CONSTRAINT $soprano - $alto <= 12
        CONSTRAINT $alto - $tenor <= 12
        CONSTRAINT $tenor - $bass <= 19
        NVALUE $cardinality OF SEQ[$soprano_class $alto_class $tenor_class $bass_class]
    THEN
        ADD ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
    END
END_GROUP
