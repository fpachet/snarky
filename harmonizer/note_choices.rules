# Les choix harmoniques et les choix de réalisation appartiennent à deux
# étapes distinctes. Le contrôleur conserve les points de retour de l'étape
# harmonique lorsqu'il avance vers la réalisation SATB.

GROUP choose_harmonic_plan
    RULE choose_harmonic_chord
    WHEN
        ($problem kind csp_problem)
        ($problem variable $variable)
        ($variable kind harmonic_chord)
        NOT EXISTS ($variable value $assigned)
    THEN
        CHOICE ($variable decision $chosen) WEIGHT $weight
        FROM
            ($variable candidate $chosen)
            ($variable choice_weight SEQ[$chosen $weight])
        END_CHOICE
    END

    RULE choose_melodic_role
    WHEN
        ($problem kind csp_problem)
        ($problem variable $variable)
        ($variable kind melodic_role)
        NOT EXISTS ($variable value $assigned)
    THEN
        CHOICE ($variable decision $chosen) WEIGHT $weight
        FROM
            ($variable candidate $chosen)
            ($variable choice_weight SEQ[$chosen $weight])
        END_CHOICE
    END
END_GROUP

GROUP choose_satb_realization
    RULE choose_harmonic_inversion
    WHEN
        ($problem kind csp_problem)
        ($problem variable $variable)
        ($variable kind harmonic_inversion)
        NOT EXISTS ($variable value $assigned)
    THEN
        CHOICE ($variable decision $chosen) WEIGHT $weight
        FROM
            ($variable candidate $chosen)
            ($variable choice_weight SEQ[$chosen $weight])
        END_CHOICE
    END

    RULE choose_voice_pitch
    WHEN
        ($problem kind csp_problem)
        ($problem variable $variable)
        ($variable kind voice_note)
        NOT EXISTS ($variable value $assigned)
    THEN
        CHOICE ($variable decision $chosen) WEIGHT $weight
        FROM
            ($variable candidate $chosen)
            ($variable choice_weight SEQ[$chosen $weight])
        END_CHOICE
    END
END_GROUP

GROUP apply_harmonizer_decisions
    RULE restrict_chosen_harmonizer_domain
    WHEN
        ($variable decision $chosen)
        ($variable candidate $other)
        $other != $chosen
    THEN
        REMOVE ($variable candidate $other)
    END

    RULE reject_missing_harmonizer_choice
    WHEN
        ($variable decision $chosen)
        NOT EXISTS
            ($variable candidate $chosen)
        END_EXISTS
    THEN
        ADD (search state contradiction)
        ADD (search invalid_choice $variable)
    END
END_GROUP
