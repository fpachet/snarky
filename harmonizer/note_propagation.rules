# Canalisation réversible entre l'accord, le renversement, les quatre notes et
# les voicings engendrés. Chaque domaine perd une valeur sans support, et tout
# voicing perdant l'une de ses six composantes est retiré.

GROUP maintain_note_voicing_channel
    RULE remove_voicing_without_chord
    WHEN
        ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        ($position chord_variable $variable)
        NOT EXISTS ($variable candidate $chord)
    THEN
        REMOVE ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
    END

    RULE remove_voicing_without_inversion
    WHEN
        ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        ($position inversion_variable $variable)
        NOT EXISTS ($variable candidate $inversion)
    THEN
        REMOVE ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
    END

    RULE remove_voicing_without_soprano
    WHEN
        ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        ($position soprano_variable $variable)
        NOT EXISTS ($variable candidate $soprano)
    THEN
        REMOVE ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
    END

    RULE remove_voicing_without_alto
    WHEN
        ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        ($position alto_variable $variable)
        NOT EXISTS ($variable candidate $alto)
    THEN
        REMOVE ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
    END

    RULE remove_voicing_without_tenor
    WHEN
        ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        ($position tenor_variable $variable)
        NOT EXISTS ($variable candidate $tenor)
    THEN
        REMOVE ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
    END

    RULE remove_voicing_without_bass
    WHEN
        ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        ($position bass_variable $variable)
        NOT EXISTS ($variable candidate $bass)
    THEN
        REMOVE ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
    END

    RULE remove_unsupported_chord
    WHEN
        ($position chord_variable $variable)
        ($variable candidate $chord)
        NOT EXISTS
            ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        END_NOT_EXISTS
    THEN
        REMOVE ($variable candidate $chord)
    END

    RULE remove_unsupported_inversion
    WHEN
        ($position inversion_variable $variable)
        ($variable candidate $inversion)
        NOT EXISTS
            ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        END_NOT_EXISTS
    THEN
        REMOVE ($variable candidate $inversion)
    END

    RULE remove_unsupported_soprano
    WHEN
        ($position soprano_variable $variable)
        ($variable candidate $soprano)
        NOT EXISTS
            ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        END_NOT_EXISTS
    THEN
        REMOVE ($variable candidate $soprano)
    END

    RULE remove_unsupported_alto
    WHEN
        ($position alto_variable $variable)
        ($variable candidate $alto)
        NOT EXISTS
            ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        END_NOT_EXISTS
    THEN
        REMOVE ($variable candidate $alto)
    END

    RULE remove_unsupported_tenor
    WHEN
        ($position tenor_variable $variable)
        ($variable candidate $tenor)
        NOT EXISTS
            ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        END_NOT_EXISTS
    THEN
        REMOVE ($variable candidate $tenor)
    END

    RULE remove_unsupported_bass
    WHEN
        ($position bass_variable $variable)
        ($variable candidate $bass)
        NOT EXISTS
            ($position voicing_candidate SEQ[$chord $inversion $soprano $alto $tenor $bass])
        END_NOT_EXISTS
    THEN
        REMOVE ($variable candidate $bass)
    END
END_GROUP

# La même règle contextuelle traite notes et accords : le prédécesseur fixe
# sélectionne la distribution conditionnelle de la variable courante.

GROUP update_contextual_note_weights
    RULE use_previous_value_marginal
    WHEN
        ($variable predecessor $previous)
        ($previous value $previous_value)
        ($variable candidate $value)
        ($variable choice_weight SEQ[$value $old_weight])
        ($variable conditional_weight SEQ[$previous_value $value $new_weight])
        $old_weight != $new_weight
    THEN
        REMOVE ($variable choice_weight SEQ[$value $old_weight])
        ADD ($variable choice_weight SEQ[$value $new_weight])
    END
END_GROUP

GROUP interpret_note_harmonization
    RULE expose_selected_harmony_and_notes
    WHEN
        ($position chord_variable $chord_variable)
        ($position inversion_variable $inversion_variable)
        ($position soprano_variable $soprano_variable)
        ($position alto_variable $alto_variable)
        ($position tenor_variable $tenor_variable)
        ($position bass_variable $bass_variable)
        ($chord_variable value $chord)
        ($inversion_variable value $inversion)
        ($soprano_variable value $soprano)
        ($alto_variable value $alto)
        ($tenor_variable value $tenor)
        ($bass_variable value $bass)
    THEN
        ADD ($position selected_chord $chord)
        ADD ($position selected_inversion $inversion)
        ADD ($position soprano $soprano)
        ADD ($position alto $alto)
        ADD ($position tenor $tenor)
        ADD ($position bass $bass)
        ADD ($position selected_voicing SEQ[$soprano $alto $tenor $bass])
    END

    RULE recognize_note_harmonization
    WHEN
        (roy_note_harmonization state solved)
    THEN
        ADD (roy_note_harmonization result harmonized)
    END
END_GROUP
