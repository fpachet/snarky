# Analyse locale de la soprano donnée. Les rôles sont des candidats CSP :
# le contour et la métrique les rendent admissibles, puis la canalisation avec
# l'accord et le voicing décide conjointement du rôle réellement sélectionné.

GROUP classify_melodic_durations
    # Dans le profil courant, les durées sont exprimées en noires. Une note
    # courte ne dépasse ni une noire ni la durée de ses deux voisines.
    RULE classify_contextually_short_note
    WHEN
        ($previous successor $position)
        ($position successor $next)
        ($previous note_duration $previous_duration)
        ($position note_duration $current_duration)
        ($next note_duration $next_duration)
        CONSTRAINT $current_duration <= 1
        CONSTRAINT $current_duration <= $previous_duration
        CONSTRAINT $current_duration <= $next_duration
    THEN
        ADD ($position duration_role short)
    END
END_GROUP

GROUP derive_melodic_roles
    RULE derive_ascending_passing_tone
    WHEN
        ($position given_voice soprano)
        ($position metric_strength weak)
        ($position duration_role short)
        ($previous successor $position)
        ($position successor $next)
        ($previous soprano_variable $previous_variable)
        ($position soprano_variable $current_variable)
        ($next soprano_variable $next_variable)
        ($previous_variable candidate $previous_pitch)
        ($current_variable candidate $current_pitch)
        ($next_variable candidate $next_pitch)
        CONSTRAINT $current_pitch - $previous_pitch >= 1
        CONSTRAINT $current_pitch - $previous_pitch <= 2
        CONSTRAINT $next_pitch - $current_pitch >= 1
        CONSTRAINT $next_pitch - $current_pitch <= 2
    THEN
        ADD ($position melodic_role_candidate passing_tone)
    END

    RULE derive_descending_passing_tone
    WHEN
        ($position given_voice soprano)
        ($position metric_strength weak)
        ($position duration_role short)
        ($previous successor $position)
        ($position successor $next)
        ($previous soprano_variable $previous_variable)
        ($position soprano_variable $current_variable)
        ($next soprano_variable $next_variable)
        ($previous_variable candidate $previous_pitch)
        ($current_variable candidate $current_pitch)
        ($next_variable candidate $next_pitch)
        CONSTRAINT $previous_pitch - $current_pitch >= 1
        CONSTRAINT $previous_pitch - $current_pitch <= 2
        CONSTRAINT $current_pitch - $next_pitch >= 1
        CONSTRAINT $current_pitch - $next_pitch <= 2
    THEN
        ADD ($position melodic_role_candidate passing_tone)
    END

    RULE derive_upper_neighbor_tone
    WHEN
        ($position given_voice soprano)
        ($position metric_strength weak)
        ($position duration_role short)
        ($previous successor $position)
        ($position successor $next)
        ($previous soprano_variable $previous_variable)
        ($position soprano_variable $current_variable)
        ($next soprano_variable $next_variable)
        ($previous_variable candidate $previous_pitch)
        ($current_variable candidate $current_pitch)
        ($next_variable candidate $next_pitch)
        $previous_pitch == $next_pitch
        CONSTRAINT $current_pitch - $previous_pitch >= 1
        CONSTRAINT $current_pitch - $previous_pitch <= 2
    THEN
        ADD ($position melodic_role_candidate upper_neighbor)
    END

    RULE derive_lower_neighbor_tone
    WHEN
        ($position given_voice soprano)
        ($position metric_strength weak)
        ($position duration_role short)
        ($previous successor $position)
        ($position successor $next)
        ($previous soprano_variable $previous_variable)
        ($position soprano_variable $current_variable)
        ($next soprano_variable $next_variable)
        ($previous_variable candidate $previous_pitch)
        ($current_variable candidate $current_pitch)
        ($next_variable candidate $next_pitch)
        $previous_pitch == $next_pitch
        CONSTRAINT $previous_pitch - $current_pitch >= 1
        CONSTRAINT $previous_pitch - $current_pitch <= 2
    THEN
        ADD ($position melodic_role_candidate lower_neighbor)
    END

    RULE derive_suspension
    WHEN
        ($position given_voice soprano)
        ($position metric_strength strong)
        ($previous successor $position)
        ($position successor $next)
        ($previous soprano_variable $previous_variable)
        ($position soprano_variable $current_variable)
        ($next soprano_variable $next_variable)
        ($previous_variable candidate $previous_pitch)
        ($current_variable candidate $current_pitch)
        ($next_variable candidate $next_pitch)
        $previous_pitch == $current_pitch
        CONSTRAINT $current_pitch - $next_pitch >= 1
        CONSTRAINT $current_pitch - $next_pitch <= 2
    THEN
        ADD ($position melodic_role_candidate suspension)
    END

    RULE derive_ascending_anticipation
    WHEN
        ($position given_voice soprano)
        ($position metric_strength weak)
        ($position duration_role short)
        ($previous successor $position)
        ($position successor $next)
        ($previous soprano_variable $previous_variable)
        ($position soprano_variable $current_variable)
        ($next soprano_variable $next_variable)
        ($previous_variable candidate $previous_pitch)
        ($current_variable candidate $current_pitch)
        ($next_variable candidate $next_pitch)
        $current_pitch == $next_pitch
        CONSTRAINT $current_pitch - $previous_pitch >= 1
        CONSTRAINT $current_pitch - $previous_pitch <= 2
    THEN
        ADD ($position melodic_role_candidate anticipation)
    END

    RULE derive_descending_anticipation
    WHEN
        ($position given_voice soprano)
        ($position metric_strength weak)
        ($position duration_role short)
        ($previous successor $position)
        ($position successor $next)
        ($previous soprano_variable $previous_variable)
        ($position soprano_variable $current_variable)
        ($next soprano_variable $next_variable)
        ($previous_variable candidate $previous_pitch)
        ($current_variable candidate $current_pitch)
        ($next_variable candidate $next_pitch)
        $current_pitch == $next_pitch
        CONSTRAINT $previous_pitch - $current_pitch >= 1
        CONSTRAINT $previous_pitch - $current_pitch <= 2
    THEN
        ADD ($position melodic_role_candidate anticipation)
    END
END_GROUP

GROUP prepare_melodic_role_domains
    RULE admit_derived_melodic_role
    WHEN
        ($position melodic_role_variable $variable)
        ($position melodic_role_candidate $role)
    THEN
        ADD ($variable candidate $role)
    END
END_GROUP
