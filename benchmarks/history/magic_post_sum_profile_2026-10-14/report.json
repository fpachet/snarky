    "PYTHONHASHSEED=0 PYTHONPATH=src:. python -m experiments.neural_attention.magic_residual_profile --native-sum --sizes 20 --large-nodes 1000 --repeats 3 --output generated/neural_attention/post_sum_large_NEW"
  ]
