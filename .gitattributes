# External conformance fixtures may intentionally exercise line endings or
# byte-level syntax. Never normalize their contents.
third_party/test_rulebases/** -text

# Keep the historical binary presentation unchanged.
*.ppt binary
*.pdf binary

# Preserve generated profiler output, including its trailing blank lines.
benchmarks/history/**/magic[0-9]*_*.txt whitespace=-blank-at-eof

# Preserve raw otool section dumps used for executable-byte comparisons.
benchmarks/history/magic_model_compilation_2026-10-14/code_sections/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
