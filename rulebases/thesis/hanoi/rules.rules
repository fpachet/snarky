GROUP solve_hanoi
    # Cas terminal : un sous-probleme a un disque est directement resolu.
    # Le mouvement est porte par l'identifiant du sous-probleme, ce qui
    # preserve les occurrences repetees d'un meme trajet physique.
    RULE solve_one_disk
    WHEN
        ($problem kind hanoi_problem)
        ($problem disks 1)
        ($problem from $source)
        ($problem to $target)
        NOT EXISTS
            ($problem state done)
        END_NOT_EXISTS
    THEN
        ADD ($problem move SEQ[$source $target])
        ADD ($problem state done)
    END

    # Hanoi(n, source, target, spare) commence par
    # Hanoi(n - 1, source, spare, target).
    RULE create_first_subproblem
    WHEN
        ($problem kind hanoi_problem)
        ($problem disks $n)
        $n > 1
        ($problem from $source)
        ($problem to $target)
        ($problem via $spare)
        NOT EXISTS
            ($problem first_child $child)
        END_NOT_EXISTS
    THEN
        LET $smaller := $n - 1
        FRESH $child PREFIX hanoi
        ADD ($problem first_child $child)
        ADD ($child parent $problem)
        ADD ($child kind hanoi_problem)
        ADD ($child disks $smaller)
        ADD ($child from $source)
        ADD ($child to $spare)
        ADD ($child via $target)
    END

    # Le mouvement central et le second appel ne deviennent possibles
    # qu'apres la resolution du premier sous-probleme.
    RULE continue_after_first_subproblem
    WHEN
        ($problem kind hanoi_problem)
        ($problem disks $n)
        $n > 1
        ($problem from $source)
        ($problem to $target)
        ($problem via $spare)
        ($problem first_child $first)
        ($first state done)
        NOT EXISTS
            ($problem second_child $second)
        END_NOT_EXISTS
    THEN
        LET $smaller := $n - 1
        FRESH $second PREFIX hanoi
        ADD ($problem move SEQ[$source $target])
        ADD ($problem second_child $second)
        ADD ($second parent $problem)
        ADD ($second kind hanoi_problem)
        ADD ($second disks $smaller)
        ADD ($second from $spare)
        ADD ($second to $target)
        ADD ($second via $source)
    END

    # La terminaison du second fils joue le role du retour de l'appel
    # recursif et rend a son tour le pere utilisable par ses regles.
    RULE finish_problem
    WHEN
        ($problem kind hanoi_problem)
        ($problem second_child $second)
        ($second state done)
        NOT EXISTS
            ($problem state done)
        END_NOT_EXISTS
    THEN
        ADD ($problem state done)
    END
END_GROUP
