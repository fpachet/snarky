for i in `seq 1 $QRESULT_ITER`
do
	echo
	echo -n ----------------------------------------
	echo    ---------------------------------------
	echo -n "$2@$3 [With Result] - $i/$QRESULT_ITER, Start: "
	date
	echo -n ----------------------------------------
	echo    ---------------------------------------
	echo

# As above, we now only call the predicate test_write instead of test:
	if /usr/bin/time -f "%U\t%S\t%E\t%M" -o RUN_BENCH__TIME \
		xsb -e "[$PROG], test_write('$3', '$FILE'), halt."
	then
		echo "OK" >/dev/null;
	else
		echo "*** SOMETHING WENT WRONG WITH THE BENCHMARK! ***"
		exit 7
	fi

	# Finally, the two result files are combined to one line
	# in the output file (First Parameter):
	cat RUN_BENCH__RESULT RUN_BENCH__TIME >>$1

# End of loop:
done

# Remove compiled program:
if [ -e $PROG.xwam ]; then
	rm $PROG.xwam
fi


