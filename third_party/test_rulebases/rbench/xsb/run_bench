			exit 5 ;;
		*)
			ITER="$4" ;;
	esac
else
	ITER=1
fi

# Check number of iterations with writing of query result.
# If none specified, the number is 0:
if [ "$#" -eq 5 ]
then
	case "$5" in
		*[^0-9]*)
			echo "Fifth argument" \
				"(iterations with writing query result)" \
				"must be numeric:" $5 >&2
			exit 6 ;;
		*)
			QRESULT_ITER="$5" ;;
	esac
else
	QRESULT_ITER=0
fi

# Ensure that we can stop the script with Control-C:
# (The problem is that the shell does not exit on Ctrl-C (SIGINT),
# but first waits to see what the child process does.
# E.g. it could be an editor that handles Ctrl-C in some other way.
# If the child process does not tell the shell that it ended because of SIGINT,
# the shell does not exit.
# So we need to specify an explicit handler for SIGINT:
trap '
  trap - INT # restore default INT handler to avoid an endless loop
  kill -s INT "$$" # Could call exit, but parent shell should know why we died
' INT

# Print empty line to separate benchmarks:
echo

# Loop for number of iterations:
for i in `seq 1 $ITER`
do
	echo
	echo -n ----------------------------------------
	echo    ---------------------------------------
	echo -n "$2:$3 - Iteration $i/$ITER, Start: "
	date
	echo -n ----------------------------------------
	echo    ---------------------------------------
	echo

# We run xsb by loading PROG.P, and then call the test predicate.
# This writes the file RUN_BENCH__RESULT.
# In addition we call /usr/bin/time and let it write to RUN_BENCH__TIME:
	if /usr/bin/time -f "%U\t%S\t%E\t%M" -o RUN_BENCH__TIME \
		xsb -e "[$PROG], test('$3', '$FILE'), halt."
	then
		echo "OK" >/dev/null;
	else
		echo "*** SOMETHING WENT WRONG WITH THE BENCHMARK! ***"
		exit 5
	fi

	# Finally, the two result files are combined to one line
	# in the output file (First Parameter):
	cat RUN_BENCH__RESULT RUN_BENCH__TIME >>$1

# End of loop:
done

