# Compose File Name for Results:
PROG=xsb
VER=2 # Version no 2 is XSB Version 3.8.0 (Three-Buck Chuck) of Oct 28, 2017
OUT="$PROG"_"$VER"_`uname -n`_`date +%Y_%m_%d.tsv`

# Stop on error:
set -e

# Ensure that we can stop the script with Control-C:
# (The problem is that the shell does not exit on Ctrl-C (SIGINT),
# but first waits to see what the child process does.
# E.g. it could be an editor that handles Ctrl-C in some other way.
# If the child process does not tell the shell that it ended because of SIGINT,
# the shell does not exit.
# So we need to specify an explicit handler for SIGINT:
trap '
  trap - INT # restore default INT handler to avoid an endless loop
  kill -s INT "$$" # Could call exit, but parent shell should know why we died
' INT

# Print empty line to separate output from command line:
echo

# If the query result directory does not exist, create it:
if [ -e result ]; then
	echo -n "Query result directory exists already. "
	echo "Result files will be overwritten."
else
	echo "Creating directory 'result' for query results."
	mkdir result
fi

# Check whether file exists, create headline with column values:
if [ -f $OUT ]; then
	echo "$OUT exists already. Benchmark Results will be appended."
else
	echo "Output file is:       $OUT"
	echo -n "Benchmark_ID	Load	Exec	Total	Status	" >$OUT
	echo "User	System	Real	Mem" >>$OUT
fi

