/*=============================================================================
 * Tansitive closure program. Query all results (both arguments free).
 *
 * This version tables the predicate tc to ensure termination for cyclic data.
 * It uses load_dyn to load the data.
 *
 * The main program is in 'bench_lib.P'.
 * This file is a modified version of a file distributed with OpenRuleBench.
 *=============================================================================
 */

/*-----------------------------------------------------------------------------
 * ID of this Benchmark:
 *-----------------------------------------------------------------------------
 */


/*-----------------------------------------------------------------------------
 * Options:
 *-----------------------------------------------------------------------------
 */

/* Data load method: */
load_data(Filename) :- load_dync(Filename).

/* Index for the given database relation (edges of the graph): */
:- index(par/2, trie).

/* Tabling method: */
:- use_subsumptive_tabling sg/2.


/*-----------------------------------------------------------------------------
 * Benchmark Program:
 *-----------------------------------------------------------------------------
 */

 sg(Y, Y) :- par(X,Y).
 sg(X, Y) :- par(X, A), sg(A, B), par(Y, B).

/*-----------------------------------------------------------------------------
 * Benchmark Query:
 *-----------------------------------------------------------------------------
 */

bench :- sg(_,_), fail.
bench.

test(FileName) :-
load_data(FileName),
bench.
